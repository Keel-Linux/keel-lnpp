# keel-lnpp: the socket of the check page (handbook decision 0059, point 5).
# systemd holds the unix socket and starts keel-lnpp-check.service, gunicorn,
# at the first request. Nginx, as www-data, proxies /keel-check/ to it
# (/etc/nginx/keel-default.d/50-keel-lnpp.conf). No TCP port opens.
[Unit]
Description=Keel LNPP check page socket

[Socket]
ListenStream=/run/keel-lnpp/check.sock
SocketUser=www-data
SocketGroup=www-data
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
